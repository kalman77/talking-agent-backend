# Copy to .env and fill in real values. NEVER commit the real .env.
# In production, inject these as platform/OS env vars instead of a file
# (godotenv loads .env only if present and never overrides real env vars).

# ── Server ─────────────────────────────────────────────────────
PORT=8080
# Comma-separated allowed origins, or "*" for all (public demo).
# Lock down in production, e.g. https://yoursite.com,https://www.yoursite.com
ALLOWED_ORIGIN=*
MAX_SESSION_SECONDS=300
# Path to the persona prompt, relative to the backend run dir.
SYSTEM_PROMPT_PATH=./prompts/persona_aria.md

# ── Anthropic (LLM) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── ElevenLabs (STT + TTS) ─────────────────────────────────────
ELEVENLABS_API_KEY=
# Default / fallback voice id. Required UNLESS ELEVENLABS_VOICE_IDS is set.
ELEVENLABS_VOICE_ID=
# Optional per-language voice overrides. Format: lang:id,lang:id
# e.g. he:HEBREW_VOICE_ID,en:ENGLISH_VOICE_ID
ELEVENLABS_VOICE_IDS=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# ── Optional toggles ───────────────────────────────────────────
# Set to "true" to skip the Hebrew niqqud preprocessor.
DISABLE_NIQQUD=
